---
import Image from "astro/components/Image.astro";

const { title, company, timeline, image } = Astro.props;
---

<div class="flex gap-4">
    <Image
        src={image}
        alt="Ricky Roy Nardson"
        loading="lazy"
        width="80"
        height="80"
        class="size-10 md:size-16 rounded-full border border-slate-200 object-cover"
    />
    <div class="w-full flex flex-col md:flex-row items-start justify-between">
        <div class="text-sm">
            <p class="font-medium text-slate-700">{company}</p>
            <p class="text-slate-500">{title}</p>
        </div>
        <p class="text-xs md:text-sm text-slate-500">{timeline}</p>
    </div>
</div>
