---
const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full bg-white/80 backdrop-blur-md border-b border-slate-200">
    <nav class="max-w-2xl mx-auto px-4 py-4 flex justify-between items-center">
        <a href="/" class="text-sm font-semibold text-slate-900 tracking-tight">
            rrn<span class="text-blue-600">.</span>
        </a>
        <div class="flex items-center gap-6">
            <a
                href="/"
                class:list={[
                    "text-sm transition-colors duration-150",
                    pathname === "/"
                        ? "text-slate-900 font-medium"
                        : "text-slate-500 hover:text-slate-900",
                ]}
            >
                home
            </a>
            <a
                href="/posts"
                class:list={[
                    "text-sm transition-colors duration-150",
                    pathname.startsWith("/posts")
                        ? "text-slate-900 font-medium"
                        : "text-slate-500 hover:text-slate-900",
                ]}
            >
                posts
            </a>
        </div>
    </nav>
</header>
