---
import { FaMoon, FaSun } from "react-icons/fa6";

const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full bg-white/80 backdrop-blur-md border-b border-slate-200">
    <nav class="max-w-2xl mx-auto px-4 py-4 flex justify-between items-center">
        <a href="/" class="text-sm font-semibold text-slate-900 tracking-tight">
            rrn<span class="text-blue-600">.</span>
        </a>
        <div class="flex items-center gap-6">
            <a
                href="/"
                class:list={[
                    "text-sm transition-colors duration-150",
                    pathname === "/"
                        ? "text-slate-900 font-medium"
                        : "text-slate-500 hover:text-slate-900",
                ]}
            >
                home
            </a>
            <a
                href="/posts"
                class:list={[
                    "text-sm transition-colors duration-150",
                    pathname.startsWith("/posts")
                        ? "text-slate-900 font-medium"
                        : "text-slate-500 hover:text-slate-900",
                ]}
            >
                posts
            </a>
            <button
                type="button"
                id="theme-toggle"
                aria-label="Dark mode"
                aria-pressed="false"
                class="grid size-8 cursor-pointer place-items-center rounded-full text-slate-500 ring-1 ring-slate-200 transition duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-rotate-12 hover:text-blue-600 hover:ring-blue-600/50 motion-reduce:transition-none"
            >
                <FaMoon className="size-3.5 dark:hidden" aria-hidden="true" />
                <FaSun className="hidden size-3.5 dark:block" aria-hidden="true" />
            </button>
        </div>
    </nav>
</header>

<script>
    const toggle = document.getElementById("theme-toggle");
    const root = document.documentElement;
    toggle?.setAttribute("aria-pressed", String(root.classList.contains("dark")));
    toggle?.addEventListener("click", () => {
        const dark = root.classList.toggle("dark");
        toggle.setAttribute("aria-pressed", String(dark));
        try {
            localStorage.setItem("theme", dark ? "dark" : "light");
        } catch {}
    });
</script>
