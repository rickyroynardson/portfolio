---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title}</title>
        <meta name="description" content={description} />
    </head>
    <body class="bg-white flex flex-col min-h-screen">
        <a
            href="#main-content"
            class="fixed left-4 top-0 z-[100] -translate-y-full rounded border border-slate-200 bg-white px-4 py-2 text-sm font-medium text-slate-900 shadow-md transition-transform focus:translate-y-4 focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2"
        >
            Skip to main content
        </a>
        <Header />
        <main id="main-content" class="flex-1" tabindex="-1">
            <slot />
        </main>
        <Footer />
        <script>
            /** Smooth scroll after first paint — avoids blocking LCP / TBT. */
            function startLenis() {
                import("lenis").then(({ default: Lenis }) => {
                    const lenis = new Lenis({
                        lerp: 0.9,
                        smoothWheel: true,
                        duration: 0.8,
                    });
                    function raf(time: number) {
                        lenis.raf(time);
                        requestAnimationFrame(raf);
                    }
                    requestAnimationFrame(raf);
                });
            }
            if (typeof window.requestIdleCallback === "function") {
                window.requestIdleCallback(() => startLenis(), { timeout: 2500 });
            } else {
                globalThis.addEventListener("load", startLenis, { once: true });
            }
        </script>
    </body>
</html>
