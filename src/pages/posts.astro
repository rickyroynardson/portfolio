---
import NewLayout from "../layouts/NewLayout.astro";

const allPosts = Object.values(
	import.meta.glob("./posts/*.md", { eager: true }),
	// biome-ignore lint/suspicious/noExplicitAny: post is any
).sort((a: any, b: any) => {
	return (
		new Date(b.frontmatter.date).getTime() -
		new Date(a.frontmatter.date).getTime()
	);
});
---

<NewLayout
    title="Posts - Ricky Roy Nardson"
    description="A bunch of writings about my journey"
>
    <div class="max-w-2xl mx-auto p-4 py-8">
        <div class="mb-8">
            <h1 class="text-3xl lg:text-5xl font-bold text-slate-900">Posts</h1>
            <p class="lg:text-lg text-slate-700">A bunch of writings about my journey</p>
        </div>
        <div class="flex flex-col gap-4">
            {
                allPosts.map((post: any) => (
                    <a
                        href={post.url}
                        class="block p-4 rounded-lg border border-slate-200 hover:border-slate-400 transition-colors"
                    >
                        <h2 class="font-semibold text-lg">{post.frontmatter.title}</h2>
                        <p class="text-slate-500 text-sm mt-1">{post.frontmatter.description}</p>
                        <p class="text-slate-400 text-xs mt-2">
                            {new Date(post.frontmatter.date).toLocaleDateString("en-US", {
                                year: "numeric",
                                month: "long",
                                day: "numeric",
                            })}
                        </p>
                    </a>
                ))
            }
        </div>
    </div>
</NewLayout>
