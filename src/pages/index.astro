---
import Image from "astro/components/Image.astro";
import { FaAws } from "react-icons/fa6";
import {
	SiC,
	SiDocker,
	SiGit,
	SiGo,
	SiKubernetes,
	SiNodedotjs,
	SiPostgresql,
	SiPython,
	SiReact,
	SiTailwindcss,
	SiTypescript,
} from "react-icons/si";
import coldsireImage from "../assets/coldsire.webp";
import meImage from "../assets/me.webp";
import meSketchImage from "../assets/me-sketch.png";
import mhsImage from "../assets/mhs.webp";
import pmbImage from "../assets/pmb.webp";
import uibImage from "../assets/uib.webp";
import ExperienceCard from "../components/ExperienceCard.astro";
import SkillBadge from "../components/SkillBadge.astro";
import NewLayout from "../layouts/NewLayout.astro";

const skills = [
	{ name: "Go", icon: SiGo, color: "#00ADD8" },
	{ name: "TypeScript", icon: SiTypescript, color: "#3178C6" },
	{ name: "Python", icon: SiPython, color: "#3776AB" },
	{ name: "ReactJS", icon: SiReact, color: "#149ECA" },
	{ name: "TailwindCSS", icon: SiTailwindcss, color: "#06B6D4" },
	{ name: "NodeJS", icon: SiNodedotjs, color: "#5FA04E" },
	{ name: "PostgreSQL", icon: SiPostgresql, color: "#4169E1" },
	{ name: "Docker", icon: SiDocker, color: "#2496ED" },
	{ name: "Git", icon: SiGit, color: "#F05032" },
	{ name: "Kubernetes", icon: SiKubernetes, color: "#326CE5" },
	{ name: "C", icon: SiC, color: "#5C6BC0" },
	{ name: "AWS", icon: FaAws, color: "#FF9900" },
	{ name: "gRPC", color: "#244C5A" },
];
---

<NewLayout
    title="Ricky Roy Nardson"
    description="I'm Ricky Roy Nardson, a Software Engineer based in Indonesia."
>
    <section class="w-full bg-white">
        <div class="mx-auto max-w-2xl p-4">
            <div class="flex items-center justify-between">
                <div>
                    <h1 class="text-3xl lg:text-6xl font-bold text-slate-900">
                        Hi, I'm Ricky <span class="inline-block animate-wiggle"
                            >👋</span
                        >
                    </h1>
                    <p class="lg:text-2xl text-slate-700">software engineer</p>
                </div>
                <div class="relative shrink-0">
                    <button
                        type="button"
                        id="avatar"
                        aria-pressed="false"
                        aria-label="Show real photo"
                        class="peer group relative size-20 cursor-pointer lg:size-32 shrink-0 overflow-hidden rounded-full bg-linear-to-b from-sky-50 to-slate-100 shadow-sm ring-1 ring-slate-200 transition duration-500 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-rotate-3 aria-pressed:-rotate-3 hover:scale-105 aria-pressed:scale-105 hover:shadow-xl aria-pressed:shadow-xl hover:shadow-blue-600/20 aria-pressed:shadow-blue-600/20 hover:ring-2 aria-pressed:ring-2 hover:ring-blue-600/50 aria-pressed:ring-blue-600/50 motion-reduce:transition-none"
                    >
                        <Image
                            src={meSketchImage}
                            alt="Ricky Roy Nardson"
                            loading="eager"
                            decoding="async"
                            fetchpriority="high"
                            width="256"
                            height="256"
                            class="absolute inset-0 size-full object-cover transition duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-125 group-aria-pressed:scale-125 group-hover:opacity-0 group-aria-pressed:opacity-0 group-hover:blur-sm group-aria-pressed:blur-sm motion-reduce:transition-none"
                        />
                        <Image
                            src={meImage}
                            loading="eager"
                            alt=""
                            decoding="async"
                            width="256"
                            height="256"
                            class="absolute inset-0 size-full scale-125 object-cover transition-all duration-700 ease-[cubic-bezier(0.22,1,0.36,1)] [clip-path:circle(0%_at_50%_100%)] group-hover:scale-100 group-aria-pressed:scale-100 group-hover:[clip-path:circle(75%_at_50%_50%)] group-aria-pressed:[clip-path:circle(75%_at_50%_50%)] motion-reduce:transition-none"
                        />
                    </button>
                        <span
                            aria-hidden="true"
                            class="pointer-events-none absolute -bottom-1 right-0 lg:bottom-1 lg:-right-8 -rotate-6 whitespace-nowrap rounded-full bg-neutral-900 px-2.5 py-1 text-[10px] font-semibold text-neutral-50 shadow-lg shadow-black/20 ring-1 ring-neutral-700 transition duration-500 ease-[cubic-bezier(0.34,1.56,0.64,1)] peer-hover:translate-x-1 peer-hover:translate-y-3 peer-hover:-rotate-12 peer-hover:scale-110 peer-aria-pressed:translate-x-1 peer-aria-pressed:translate-y-3 peer-aria-pressed:-rotate-12 peer-aria-pressed:scale-110 lg:text-xs lg:peer-hover:translate-x-4 lg:peer-aria-pressed:translate-x-4 motion-reduce:transition-none"
                        >
                            keep learning 🚀
                        </span>
                </div>
            </div>
        </div>
    </section>
    <section class="w-full bg-white">
        <div class="mx-auto max-w-2xl p-4">
            <h2 class="lg:text-xl font-semibold text-slate-900">About<span class="text-blue-600">.</span></h2>
            <p class="text-pretty text-slate-700">
                Currently working as a Fullstack Engineer, interested in backend
                development, distributed systems, and infrastructures. Always passionate and open-minded to learn about
                new technologies.
            </p>
        </div>
    </section>
    <section class="w-full bg-white">
        <div class="mx-auto max-w-2xl p-4 space-y-2">
            <h2 class="lg:text-xl font-semibold text-slate-900">Skills<span class="text-blue-600">.</span></h2>
            <div class="flex flex-wrap items-center gap-1.5">
                {
                    skills.map((skill) => (
                        <SkillBadge {...skill} />
                    ))
                }
            </div>
        </div>
    </section>
    <section class="w-full bg-white">
        <div class="mx-auto max-w-2xl p-4 space-y-2">
            <h2 class="lg:text-xl font-semibold text-slate-900">Work Experience<span class="text-blue-600">.</span></h2>
            <div class="space-y-4">
                <ExperienceCard
                    imageLoading="eager"
                    image={coldsireImage}
                    company="ColdSire"
                    title="Software Engineer (Fullstack)"
                    timeline="Jun 2024 - Now"
                    content="Currently keeping ColdSire running smoothly so your campaigns and replies land safely every time."
                />
                <ExperienceCard
                    imageLoading="eager"
                    image={pmbImage}
                    company="PT Pundi Mas Berjaya"
                    title="Software Engineer Intern"
                    timeline="Oct 2020 - Mar 2021"
                    content="• Delivered full-cycle web development across client websites and internal tools using HTML, CSS, JavaScript, and PHP (Laravel).\n• Collaborated with QA team to identify issues early and uphold application quality standards throughout development."
                />
            </div>
        </div>
    </section>
    <section class="w-full bg-white">
        <div class="mx-auto max-w-2xl p-4 space-y-2">
            <h2 class="lg:text-xl font-semibold text-slate-900">Education<span class="text-blue-600">.</span></h2>
            <div class="space-y-4">
                <ExperienceCard
                    image={uibImage}
                    company="Universitas Internasional Batam"
                    title="Bachelor's degree, Computer Science"
                    timeline="2022 - 2026"
                    content={"CGPA: 3.94/4.0\n• Leader and full-stack developer across several team projects.\n• \"Best Paper\" awards of the 7th National Conference for Community Service Project (NaCosPro) 2025."}
                />
                <ExperienceCard
                    image={mhsImage}
                    company="SMK Multistudi High School Batam"
                    title="Vocational High School, Computer Software Engineering"
                    timeline="2019 - 2022"
                    content="• 3rd place in the Provincial Student Web Competency Competition."
                />
            </div>
        </div>
    </section>
    <section class="w-full bg-white">
        <div class="mx-auto max-w-2xl p-4 space-y-2">
            <h2 class="lg:text-xl font-semibold text-slate-900">Contact<span class="text-blue-600">.</span></h2>
            <p class="text-slate-700">
                Shoot me a dm on <a
                    href="https://www.linkedin.com/in/rickyroynardson"
                    target="_blank"
                    class="text-blue-600 underline">linkedin</a
                >. Or check my <a href="https://www.github.com/rickyroynardson" target="_blank" class="text-blue-600 underline">github</a>.
            </p>
        </div>
    </section>
<script>
    // Tap toggle for touch screens; hover covers desktop.
    const avatar = document.getElementById("avatar");
    avatar?.addEventListener("click", () => {
        const pressed = avatar.getAttribute("aria-pressed") === "true";
        avatar.setAttribute("aria-pressed", String(!pressed));
    });
</script>
</NewLayout>
